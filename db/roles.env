# The passwords of the site's database roles (db/roles.sql), read by the db-roles and backend services in
# docker-compose.yml. On the server, db-roles.env (untracked, next to .env) comes after this file and overrides them:
# deploy/deploy.sh creates it with random ones on its first run. Locally and in CI these apply.
SITE_OWNER_PASSWORD=site_owner
SITE_READER_PASSWORD=site_reader
